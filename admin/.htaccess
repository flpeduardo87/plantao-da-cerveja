Options -Indexes
DirectoryIndex index.php
RewriteEngine On

# ── Clean URLs (PT-BR slugs → PHP files) ──────────────────────────────────────
RewriteRule ^painel$        dashboard.php   [L]
RewriteRule ^pedidos$       orders.php      [L]
RewriteRule ^produtos$      products.php    [L]
RewriteRule ^categorias$    categories.php  [L]
RewriteRule ^estoque$       stock.php       [L]
RewriteRule ^relatorios$    reports.php     [L]
RewriteRule ^configuracoes$ settings.php    [L]

# ── Fallback: hide .php for any other file ─────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)$ $1.php [L]

# ── Security ───────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<FilesMatch "\.php$">
    Allow from all
</FilesMatch>
