Options -Indexes
RewriteEngine On

# Allow direct access to existing files/dirs
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Route everything to index.php (CORS is handled dynamically in index.php)
RewriteRule ^(.*)$ index.php [QSA,L]

# Handle preflight OPTIONS before rewrite conditions above apply
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ index.php [QSA,L]
